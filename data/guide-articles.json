    "id": "introduction",
    "published": false,
    "order": 0,
    "eyebrow": "INTRODUCTION",
    "title": "なぜ、浜中町を撮るのか。",
    "cardTitle": "INTRODUCTION｜浜中町を知る",
    "summary": "北海道東部、太平洋に面した浜中町。海から湿原、牧草地まで、町全体に自然が広がっています。",
    "cover": "assets/images/01_home/01_HOME.webp",
    "icon": "INTRO",
    "introduction": {
      "heroLead": ["北海道東部、太平洋に面した浜中町。", "海から湿原、牧草地まで、町全体に自然が広がっています。", "カメラを持って、ゆっくり町をめぐってみてください。"],
      "trip": {
        "title": "浜中町で撮る、4つの楽しさ。",
        "lead": { "title": "町をめぐるだけで、景色が変わる。", "paragraphs": ["太平洋に突き出す岬、霧多布湿原、広い牧草地、漁港や昆布干場。", "車を少し走らせるだけで、景色が変わります。道の先に海が見えたり、空が大きく開けたり、牧草地の向こうに生きものを見つけたり。", "町をめぐっている時間そのものが、撮影の時間になります。"], "image": "assets/images/02_gallery/tokyo_camera_club_2026/thumbs/01.webp", "alt": "浜中町の岬と海の風景" },
        "points": [
          { "title": "頑張りすぎなくても、いい景色に出会える。", "paragraphs": ["絶景を見るために、必ずしも山に登ったり、長い距離を歩いたりする必要はありません。", "車で町をめぐりながら、岬や湿原、海、牧草地へ。少し車を停めて景色を眺めたり、気になった場所でカメラを構えたり。休みながら、自分のペースで写真を楽しめます。"], "image": "assets/images/02_gallery/tokyo_camera_club_2026/thumbs/02.webp", "alt": "浜中町の海辺の風景" },
          { "title": "思いがけない出会いがある。", "paragraphs": ["浜中町の海には、野生のラッコが暮らしています。湿原ではタンチョウや野鳥。町を走っていると、エゾシカやキタキツネに出会うこともあります。", "海を撮るつもりで出かけた日に、途中で生きものに出会う。そんな予定外の一枚も、浜中町で撮る楽しさです。"], "image": "assets/images/02_gallery/tokyo_camera_club_2026/thumbs/04.webp", "alt": "浜中町の野生動物" }
        ]
      },
      "living": { "title": "暮らすように旅して、撮る。", "paragraphs": ["朝の海を撮って、町でひと休みして、午後は湿原へ。夕方になったら、また海へ行ってみる。", "天気が変われば予定を変えて、その日の光や風に合わせて撮る。", "何日か滞在しながら町をめぐっていると、少しずつお気に入りの場所が増えていきます。", "急いでたくさんの場所を回るより、のんびり過ごしながら写真を撮る。浜中町には、そんな旅の仕方がよく似合います。"], "image": "assets/images/02_gallery/tokyo_camera_club_2026/thumbs/08.webp", "alt": "浜中町の海の風景" },
      "subjects": [
        { "eyebrow": "WILDLIFE", "title": "野生動物", "text": "野生のラッコをはじめ、タンチョウ、エゾシカ、キタキツネ、さまざまな野鳥。町の中をめぐるだけでも、生きものとの出会いがあります。", "image": "assets/images/02_gallery/tokyo_camera_club_2026/thumbs/04.webp" },
        { "eyebrow": "COAST", "title": "海と岬", "text": "太平洋、霧多布岬、断崖、灯台、波。晴れた日、霧の日、朝夕の光で、同じ場所でも景色は大きく変わります。", "image": "assets/images/02_gallery/tokyo_camera_club_2026/thumbs/01.webp" },
        { "eyebrow": "WETLAND", "title": "湿原と花", "text": "霧多布湿原を彩る季節の花、霧、空、野鳥。広い景色にも、足元の小さな風景にも被写体があります。", "image": "assets/images/01_home/01_HOME.webp" },
        { "eyebrow": "LIFE", "title": "暮らしと産業", "text": "酪農、昆布漁、港、牧草地。町の日常にも、カメラを向けたくなる風景があります。", "image": "assets/images/01_home/04_PROJECT.webp" }
      ],
      "links": [
        { "title": "写真を見る", "text": "浜中町で撮影された作品から、町の景色や生きものを見てみる。", "url": "gallery.html" },
        { "title": "撮りに行く", "text": "撮影場所、旅行準備、機材、撮影方法やルールを確認する。", "url": "guide.html" },
        { "title": "写真の取り組みを見る", "text": "写真展、撮影会、フォトコンテストなど、浜中町で行われている写真の取り組みを見る。", "url": "project.html" }
      ]
    }
  },
